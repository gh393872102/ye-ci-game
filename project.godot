; Godot 4.7.2 stable.
config_version=5

[application]
config/name="夜祠"
config/description="夜祠"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="ye-ci"

[autoload]
Rules="*res://src/autoload/Rules.gd"
Clock="*res://src/autoload/Clock.gd"
Data="*res://src/autoload/Data.gd"
Events="*res://src/autoload/Events.gd"
Settings="*res://src/autoload/Settings.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/resizable=true

[gui]
theme/custom="res://resources/p9_theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.027, 0.05, 0.067, 1)

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=2

[internationalization]
locale/fallback="zh_CN"
locale/test="zh_CN"

[input]

ui_accept={
"deadzone":0.3,
"events":[Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":4194310), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}

