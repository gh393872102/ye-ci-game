extends "res://tools/faction_baseline/OrdinaryOpening.gd"
## Replay the ordinary last map generated by OrdinaryRoute, with only legal orders.

func run() -> void:
	var args := OS.get_cmdline_user_args()
	if args.size() not in [2,3] or (args.size()==3 and args[2]!="--training"):
		quit(2)
		return
	var results := []
	probe_boss_gate = true
	if args.size()==3:
		for trainees in [["H09"],["H11"],["H13"],["H09","H11","H13"]]:
			var row := await trial(args[1],args[0],"book",[],"","post_register",trainees)
			if row.is_empty():
				quit(2)
				return
			results.append(row)
		save_results(args[0],args[1],results,"-training")
		quit()
		return
	var layouts := ["split","book","reverse","hall"]
	for layout in layouts:
		var row := await trial(args[1],args[0],layout,[],"")
		if row.is_empty():
			quit(2)
			return
		results.append(row)
	for dest in ["post_hall_door","post_stair_head","post_register"]:
		var row := await trial(args[1],args[0],"book",[],"",dest)
		if row.is_empty():
			quit(2)
			return
		results.append(row)
	var inventory: Dictionary = results[0].inventory
	for items in [["I08"],["Y11"],["I08","Y11"]]:
		if not items.all(func(id): return inventory.get(id,0)>0): continue
		for holder in ["H09","H11"]:
			var row := await trial(args[1],args[0],"book",items,holder)
			if row.is_empty():
				quit(2)
				return
			results.append(row)
	save_results(args[0],args[1],results,"")
	quit()

func save_results(seed_text: String, source: String, rows: Array, suffix: String) -> void:
	var path := "res://tools/faction_baseline/martial-final-"+seed_text+suffix+".json"
	FileAccess.open(path,FileAccess.WRITE).store_string(JSON.stringify({"seed":seed_text,"save_sha256":FileAccess.get_sha256(source),"trials":rows},"\t")+"\n")

func trial(path: String, seed_text: String, layout: String, items: Array, holder: String, aid_post := "", trainees: Array = []) -> Dictionary:
	var night: RefCounted = load("res://src/night/NightRun.gd").new()
	if not night.load_save(path).ok or night.state.phase!="map" or night.state.seed!=seed_text or night.state.get("opening_faction")!="武卫司": return {}
	var before: Array = night.state.roster.duplicate(true)
	var cash: float = night.state.incense
	var inventory: Dictionary = night.state.growth.inventory.duplicate(true)
	if before.size()!=2 or not before.any(func(u):return u.id=="H09" and u.post=="post_register") or not before.any(func(u):return u.id=="H11" and u.post=="post_hall_door"): return {}
	for guard in before:
		var target: String = guard.post
		match layout:
			"book": target = "post_register"
			"hall": target = "post_hall_door"
			"reverse": target = "post_register" if guard.id=="H11" else "post_hall_door"
		if guard.post!=target and not night.reserve_post(guard.uid,target).ok: return {}
	if night.state.incense!=cash or not night.choose_node("n10").ok: return {}
	var b := await fight(night,"武卫司",seed_text,false,aid_post,false,"H13",true,false,1,items,false,-1,"",holder,false,"",0.0,false,false,trainees)
	if b.get("additional_training",[]).size()!=trainees.size() or not b.get("additional_training",[]).all(func(r):return r.ok and r.paid>0): return {}
	if not b.get("settled",false) or not b.foreign_units.is_empty(): return {}
	if not aid_post.is_empty() and (not b.aid.placed or b.aid.paid!=10): return {}
	for receipt in b.get("gear",[]):
		if not receipt.ok or receipt.before-receipt.after!=1 or receipt.paid!=0: return {}
	if b.get("gear",[]).size()!=items.size(): return {}
	return {"layout":layout,"inventory":inventory,"cash":cash,"holder":holder,"items":items,"before":before,"battle":b}
